---
const apps = Array.from({ length: 5 }, (_, i) => i + 1)
---

<!-- 头部导航区域 -->
<header class="lts-header">
  <!-- 头部导航左侧区域 -->
  <div class="lts-header__start">
    <!-- 侧边栏折叠触发按钮 -->
    <!-- data-lts-toggle="pushmenu" -->
    <button
      class="lts-header__action test-push-menu"
      type="button"
      data-lts-toggle="pushmenu"
    >
      <i class="bi bi-list"></i>
    </button>
  </div>
  <!-- 头部导航中间区域 -->
  <div class="lts-header__center px-3"></div>

  <!-- 头部导航右侧区域 -->
  <div class="lts-header__end">
    <!-- 搜索按钮 -->
    <button class="lts-header__action" aria-label="搜索" title="搜索">
      <i class="bi bi-search"></i>
    </button>
    <!-- 通知按钮 -->
    <button class="lts-header__action" aria-label="通知" title="通知">
      <i class="bi bi-bell"></i>
      <span class="lts-header__notification-dot"></span>
    </button>
    <!-- 拓展菜单按钮(建议把拓展放在此处,以免破坏头部整体布局,不需要可以直接删除) -->
    <button
      class="lts-header__action"
      data-bs-toggle="menu"
      data-bs-placement="bottom-end"
      data-bs-auto-close="outside"
      aria-expanded="false"
      title="应用"
    >
      <i class="bi bi-grid"></i>
    </button>

    <!-- 全屏按钮 -->
    <button class="lts-header__action" title="全屏">
      <i class="bi bi-arrows-fullscreen"></i>
    </button>
    <!-- 调色盘按钮 -->
    <button class="lts-header__action" title="主题">
      <i class="bi bi-palette"></i>
    </button>
    <!-- 管理员信息区域 -->
    <div data-bs-toggle="menu" aria-expanded="false">
      <div class="lts-header__user-info">
        <img
          src="assets/img/avatar.jpg"
          class="lts-header__avatar"
          alt="用户头像"
        />
        <!-- 管理员详情信息(如果你只需要头像那么你可以直接把下面这部分删除) -->
        <div class="lts-header__details">
          <!-- 管理员账号/昵称 -->
          <div class="lts-header__nickname">欲饮琵琶码上催</div>
          <!-- 管理员角色(不需要可删除,上面的用户昵称可自动垂直居中) -->
          <div class="lts-header__role">超级管理员</div>
        </div>
      </div>
    </div>
  </div>
</header>
<!-- /头部导航区域 -->
