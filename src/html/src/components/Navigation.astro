---
import menus from "@data/sidebar"
import NavigationItem from "@components/navigation/NavigationItem.astro"
import NavigationSeparator from "@components/navigation/NavigationSeparator.astro"
import NavigationSubheader from "@components/navigation/NavigationSubheader.astro"
---

<!-- 导航栏 -->
<ul
  data-lts-treeview-initialize
  data-lts-toggle="treeview"
  data-lts-accordion="true"
  class="lts-navigation"
>
  {
    menus.map((item) => {
      // 分隔符
      if (item.separator) {
        return (
          <>
            <NavigationSeparator />
          </>
        )
      }

      // 副标题
      if (item.subheader) {
        return <NavigationSubheader item={item} />
      }

      // 普通菜单
      return <NavigationItem item={item} />
    })
  }
</ul>
<!-- /导航栏 -->
