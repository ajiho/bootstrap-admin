{
  "name": "adminlts",
  "version": "1.1.0",
  "description": "open source responsive background management template based on bootstrap 5",
  "keywords": [
    "admin",
    "adminlte",
    "adminlts",
    "bootstrap",
    "bootstrap5",
    "control-panel",
    "css",
    "dashboard",
    "framework",
    "front-end",
    "mobile-first",
    "responsive",
    "sass",
    "template",
    "web"
  ],
  "homepage": "https://github.com/ColoristLab/AdminLTS",
  "bugs": {
    "url": "https://github.com/ColoristLab/AdminLTS/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColoristLab/AdminLTS.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "files": [
    "!dist/docs/**",
    "dist/",
    "src/"
  ],
  "type": "module",
  "exports": {
    ".": {},
    "./dist/*": "./dist/*",
    "./src/scss/*": "./src/scss/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "fmt": "oxfmt",
    "lint:check:js": "oxlint",
    "lint:check:css": "stylelint src/**/*.scss --cache",
    "lint:fix:js": "pnpm run lint:check:js --fix",
    "lint:fix:css": "pnpm run lint:check:css --fix",
    "lint": "run-p lint:check:*",
    "lint:fix": "run-p lint:fix:*",
    "docs:dev": "vitepress dev docs --open",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "css:build:base": "tsx build/css.ts",
    "css:build:min": "cross-env NODE_ENV=production run-s css:build:base",
    "css": "run-s css:build:*",
    "typecheck": "tsc",
    "publint": "publint",
    "tsdown": "tsdown",
    "js": "rolldown -c",
    "html:dev": "astro dev --root src/html --open",
    "html:preview": "astro preview --root src/html",
    "html:build": "astro build --root src/html",
    "html:build:flatten": "tsx build/html-flatten.ts",
    "html:build:format": "prettier --write dist/**/*.html --ignore-path=''",
    "html:build:beautify": "js-beautify --no-preserve-newlines -m -1 -s 2 --type html --replace dist/*.html",
    "html": "run-s html:build{,:*}",
    "watch:css": "tsx --watch-path ./src/scss build/css.ts",
    "watch:js": "rolldown -c --watch",
    "watch": "run-p watch:*",
    "dev": "concurrently \"pnpm watch\" \"pnpm html:dev\"",
    "assets:lib": "tsx build/libs-copy.ts",
    "assets:geo": "tsx build/geo-json.ts",
    "assets": "run-s assets:*",
    "zip": "tsx build/zip.ts",
    "build": "run-s clean format lint css tsdown assets html zip",
    "release": "releaseasy"
  },
  "devDependencies": {
    "@namics/stylelint-bem": "^11.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.5",
    "astro": "^7.3.8",
    "axios": "^1.20.0",
    "bootstrap": "6.0.0-alpha.1",
    "bootstrap-icons": "^1.13.2",
    "browserslist": "^4.29.3",
    "concurrently": "^10.0.6",
    "consola": "^3.4.2",
    "cross-env": "^10.1.0",
    "dataset-config": "^1.3.0",
    "datatables.net-dt": "^3.1.4",
    "fs-extra": "^11.4.1",
    "jquery": "^4.0.0",
    "js-beautify": "^2.0.3",
    "lightningcss": "^1.33.0",
    "lit-html": "^3.3.3",
    "medium-zoom": "^1.1.0",
    "npm-run-all2": "^9.0.3",
    "overlayscrollbars": "^2.16.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.88.0",
    "pathe": "^2.0.3",
    "postcss": "^8.5.30",
    "postcss-custom-properties-prefix": "^0.1.0",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "publint": "^0.3.25",
    "quicktab": "^0.0.8",
    "releaseasy": "^0.1.1",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.14",
    "sass": "^1.105.1",
    "sirv": "^3.0.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitest": "^5.0.4",
    "zip-lib": "^1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.22.3 || ^24.16.0 || >=26.3.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
